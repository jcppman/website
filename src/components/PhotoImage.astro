---
import { Picture } from 'astro:assets';
import type { Photo } from '../lib/photos';
interface Props {
  photo: Photo;
  lead?: boolean;
  wide?: boolean;
}
const { photo, lead = false, wide = lead } = Astro.props;
---

<Picture
  src={photo.image}
  alt={photo.alt}
  formats={['avif', 'webp']}
  fallbackFormat="webp"
  widths={wide ? [800, 1200, 1600, 2000] : [480, 800, 1200]}
  sizes={
    wide
      ? '(max-width: 740px) 92vw, (max-width: 1560px) 69vw, 1080px'
      : '(max-width: 740px) 92vw, (max-width: 1560px) 35vw, 540px'
  }
  loading={lead ? 'eager' : 'lazy'}
  fetchpriority={lead ? 'high' : undefined}
/>
