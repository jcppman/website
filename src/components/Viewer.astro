<dialog class="photo-viewer" aria-label="Photograph viewer" closedby="any">
  <form method="dialog">
    <button class="viewer-close" aria-label="Close viewer" autofocus>
      ×
    </button>
  </form>
  <img class="viewer-image" alt="" />
  <button type="button" class="viewer-prev" aria-label="Previous photograph">
    ←
  </button>
  <button type="button" class="viewer-next" aria-label="Next photograph">
    →
  </button>
  <span class="viewer-position" role="status"></span>
</dialog>
<script>
  const viewer = document.querySelector<HTMLDialogElement>('.photo-viewer')!;
  const image = viewer.querySelector<HTMLImageElement>('.viewer-image')!;
  const position = viewer.querySelector<HTMLElement>('.viewer-position')!;
  const links = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('.photo-open'),
  );
  let current = 0;
  let switching = false;

  function display(index: number) {
    switching = viewer.open;
    current = (index + links.length) % links.length;
    const link = links[current];
    image.alt = link.querySelector('img')!.alt;
    image.src = link.href;
    position.textContent = current + 1 + ' / ' + links.length;
  }

  image.addEventListener('load', () => {
    if (
      viewer.open &&
      switching &&
      matchMedia('(prefers-reduced-motion: no-preference)').matches
    ) {
      for (const animation of image.getAnimations()) animation.cancel();
      image.animate([{ opacity: 0.25 }, { opacity: 1 }], {
        duration: 150,
        easing: 'ease-out',
      });
    }
  });
  links.forEach((link, i) =>
    link.addEventListener('click', (event) => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey)
        return;
      event.preventDefault();
      display(i);
      viewer.showModal();
    }),
  );
  viewer
    .querySelector('.viewer-prev')!
    .addEventListener('click', () => display(current - 1));
  viewer
    .querySelector('.viewer-next')!
    .addEventListener('click', () => display(current + 1));
  viewer.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
      event.preventDefault();
      display(current + (event.key === 'ArrowLeft' ? -1 : 1));
    }
  });
</script>
