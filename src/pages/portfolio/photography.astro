---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Site from '../../layouts/Site.astro';
import PhotoImage from '../../components/PhotoImage.astro';
import Outline from '../../components/Outline.astro';
import Viewer from '../../components/Viewer.astro';
import { featuredPhoto, groups, photos } from '../../lib/photos';

const summerPhotos = [
  '20260815-8',
  '20260609-11',
  '20260609-10',
  '20260609-9',
].map(featuredPhoto);

const sections = Array.from(groups).flatMap(([month, photos]) => {
  const remaining = photos.filter((photo) => !summerPhotos.includes(photo));
  const monthSections = [];
  if (month === summerPhotos[0].month) {
    monthSections.push({
      id: 'photos-2026-06-to-08',
      title: 'June–August 2026',
      monthAnchor: remaining.length ? undefined : 'photos-' + month,
      photos: summerPhotos,
    });
  }
  if (remaining.length) {
    monthSections.push({
      id: 'photos-' + month,
      title: remaining[0].label,
      photos: remaining,
    });
  }
  return monthSections;
});
const years = Array.from(groups.keys()).map((month) => month.slice(0, 4));
const span =
  years.at(-1) === years[0] ? years[0] : years.at(-1) + '–' + years[0];
async function viewerSources(image: ImageMetadata) {
  const scale = Math.max(image.width, image.height);
  const widths = [1280, 1920]
    .filter((edge) => edge <= scale)
    .map((edge) => Math.round((image.width * edge) / scale));
  if (!widths.length) widths.push(image.width);
  const srcset = async (format: 'avif' | 'webp') => {
    const images = await Promise.all(
      widths.map((width) => getImage({ src: image, width, format })),
    );
    return images.map((img, i) => img.src + ' ' + widths[i] + 'w').join(', ');
  };
  const [avif, webp] = await Promise.all([srcset('avif'), srcset('webp')]);
  return {
    avif,
    webp,
    href: webp.split(', ').at(-1)!.split(' ')[0],
    ratio: image.width / image.height,
  };
}
const albums = await Promise.all(
  sections.map(async (section) => ({
    ...section,
    photos: await Promise.all(
      section.photos.map(async (photo) => ({
        photo,
        full: await viewerSources(photo.image),
      })),
    ),
  })),
);
---

<Site page="Photography">
  <header class="page-head">
    <h2>Photographs</h2>
    <p>{photos.length} photographs · {span}</p>
  </header>
  {albums.map(({ id, title, photos, monthAnchor }, index) => {
    const first = photos[0].photo.image;
    const lead = photos.length > 2 && first.width > first.height;
    const rest = lead ? photos.slice(1) : photos;
    return (
      <>
        {index > 0 && <hr class="crop-marks registration" />}
        <section class="album" id={id} aria-labelledby={id + '-title'}>
          <h3 class="visually-hidden" id={id + '-title'}>{title}</h3>
          <div id={monthAnchor}>
            {lead && (
              <figure class="album-lead">
                <a
                  class="photo-open"
                  href={photos[0].full.href}
                  data-avif={photos[0].full.avif}
                  data-webp={photos[0].full.webp}
                  data-ratio={photos[0].full.ratio}
                  aria-haspopup="dialog"
                  aria-label={'Open photograph: ' + photos[0].photo.alt}
                >
                  <PhotoImage photo={photos[0].photo} wide />
                </a>
              </figure>
            )}
            <div class="photos">
              {rest.map(({ photo, full }) => (
                <figure>
                  <a
                    class="photo-open"
                    href={full.href}
                    data-avif={full.avif}
                    data-webp={full.webp}
                    data-ratio={full.ratio}
                    aria-haspopup="dialog"
                    aria-label={'Open photograph: ' + photo.alt}
                  >
                    <PhotoImage photo={photo} />
                  </a>
                </figure>
              ))}
            </div>
          </div>
        </section>
      </>
    );
  })}
  <Fragment slot="overlay">
    <Outline items={albums} />
    <Viewer />
  </Fragment>
  <script>
    import '../../lib/masonry';
  </script>
</Site>
