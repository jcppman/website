---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import Site from '../../layouts/Site.astro';
import Outline from '../../components/Outline.astro';

const releases = (await getCollection('releases')).sort(
  (a, b) =>
    parseInt(b.data.year) - parseInt(a.data.year) ||
    b.data.title.localeCompare(a.data.title),
);
const items = releases.map(({ id, data }) => ({
  id: 'release-' + id,
  title: data.title,
  cover: data.img,
  artist: data.artists.join(', '),
}));
const years = releases.map(({ data }) => data.year.replace(/\s*-\s*/, '–'));
---

<Site page="Music">
  <header class="page-head">
    <h2>Music</h2>
    <p>{releases.length} records</p>
  </header>
  <ol class="ledger">
    {releases.map(({ data }, i) => (
      <li class="entry" id={items[i].id}>
        <p class="entry-year" aria-hidden={years[i] === years[i - 1] ? 'true' : undefined}>
          {years[i] !== years[i - 1] && years[i]}
        </p>
        <a class="framed cover-link" href={data.links[0].url} tabindex="-1" aria-hidden="true">
          <Picture
            src={data.img}
            alt={data.title + ' cover'}
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            widths={[320, 560, 800]}
            sizes="(max-width: 740px) 92vw, (max-width: 1560px) 27vw, 420px"
            loading={i === 0 ? 'eager' : 'lazy'}
          />
        </a>
        <div class="entry-body">
          <h3>{data.title}</h3>
          {data.artists.join(', ') !== data.title && (
            <p class="artist">{data.artists.join(', ')}</p>
          )}
          <ul class="roles" aria-label="Roles">
            {data.roles.map((role) => <li>{role}</li>)}
          </ul>
          <p class="meta">
            <span class="visually-hidden">{years[i]} · </span>
            {data.types.join(' · ')}
          </p>
          <p class="listen">
            {data.links.map((link) => (
              <a class="action" href={link.url}>
                Listen on {link.title}
              </a>
            ))}
          </p>
        </div>
      </li>
    ))}
  </ol>
  <Outline slot="overlay" items={items} />
</Site>
