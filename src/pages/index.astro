---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Site from '../layouts/Site.astro';
import PhotoImage from '../components/PhotoImage.astro';
import { featuredPhoto } from '../lib/photos';

const lead = featuredPhoto('20240927-7');
const selections = ['20240226-2', '20240217-3'].map(featuredPhoto);
const releases = await Promise.all(
  ['sun-moon-holy-cult', 'chimera-cult-join-the-cult'].map(async (id) => {
    const entry = await getEntry('releases', id);
    if (!entry) throw new Error('Unknown featured release: ' + id);
    return entry.data;
  }),
);
---

<Site page="Home">
  <p class="statement">
    I <a href="https://github.com/jcppman">build software</a>,{' '}
    <a href="/portfolio/music/">make records</a> and{' '}
    <a href="/portfolio/photography/">take photographs</a>.
  </p>
  <figure class="lead">
    <div class="framed settle">
      <PhotoImage photo={lead} lead />
    </div>
    <figcaption>
      {[lead.caption, lead.label].filter(Boolean).join(' · ')}
    </figcaption>
  </figure>
  <section class="selection" aria-labelledby="home-music">
    <div class="selection-head">
      <h2 id="home-music">Music</h2>
      <a class="more" href="/portfolio/music/">All records</a>
    </div>
    <div class="records">
      {releases.map((release) => (
        <figure>
          <a
            class="framed cover-link"
            href={release.links[0].url}
            tabindex="-1"
            aria-hidden="true"
          >
            <Image
              src={release.img}
              alt={release.title + ' cover'}
              widths={[320, 540, 800]}
              sizes="(max-width:740px) 92vw, 44vw"
              format="webp"
            />
          </a>
          <figcaption>
            <strong>
              <a href={release.links[0].url}>{release.title}</a>
            </strong>
            {release.artists.join(', ') !== release.title && (
              <span class="artist">{release.artists.join(', ')}</span>
            )}
            <ul class="roles" aria-label="Roles">
              {release.roles.map((role) => <li>{role}</li>)}
            </ul>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>
  <section class="selection" aria-labelledby="home-photographs">
    <div class="selection-head">
      <h2 id="home-photographs">Photographs</h2>
      <a class="more" href="/portfolio/photography/">All photographs</a>
    </div>
    <div class="photos">
      {selections.map((photo) => (
        <figure>
          <PhotoImage photo={photo} />
          <figcaption>{photo.label}</figcaption>
        </figure>
      ))}
    </div>
  </section>
  <script>
    import '../lib/masonry';
  </script>
</Site>
