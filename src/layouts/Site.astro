---
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '../styles/site.css';
import { PUBLIC_GTAG_ID, NUXT_PUBLIC_GTAG_ID } from 'astro:env/server';
import { getCollection } from 'astro:content';
import { photos } from '../lib/photos';

interface Props {
  page: 'Home' | 'Music' | 'Photography';
}
const { page } = Astro.props;
const pages = {
  Home: '/',
  Music: '/portfolio/music/',
  Photography: '/portfolio/photography/',
};
const linkGroups = {
  Software: {
    GitHub: 'https://github.com/jcppman',
    Audiorective: 'https://github.com/rytho-ai/audiorective',
  },
  Elsewhere: {
    'Molten Steel Studios': 'https://youtube.com/@moltensteelstudios722',
    'Personal YouTube': 'https://youtube.com/@chriestyuintheworld',
    Instagram: 'https://instagram.com/chriest.yu',
    LinkedIn: 'https://linkedin.com/in/chriestyu',
  },
};
const recordCount = (await getCollection('releases')).length;
const intro = 'I build software, make records and take photographs.';
const analytics = PUBLIC_GTAG_ID || NUXT_PUBLIC_GTAG_ID;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#211d23" />
    <meta name="description" content={intro} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={new URL(pages[page], Astro.site)} />
    <title>{page === 'Home' ? 'Chriest Yu' : page + ' · Chriest Yu'}</title>
    {analytics && (
      <script
        is:inline
        async
        src={
          'https://www.googletagmanager.com/gtag/js?id=' +
          encodeURIComponent(analytics)
        }
      ></script>
    )}
    {analytics && <script define:vars={{ analytics }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        window.dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', analytics);
    </script>}
  </head>
  <body>
    <a class="skip" href="#content">
      Skip to content
    </a>
    <div class="shell">
      <header class="masthead">
        <h1>
          <a href="/">Chriest Yu</a>
        </h1>
        <nav aria-label="Site">
          {Object.entries(pages).map(([name, href]) => (
            <a href={href} aria-current={page === name ? 'page' : undefined}>
              {name}
            </a>
          ))}
        </nav>
      </header>
      <main id="content" tabindex="-1" aria-label={page}>
        <slot />
      </main>
      <footer class="colophon">
        <hr class="crop-marks" />
        <div class="colophon-grid">
          <p class="signoff">
            <strong>Chriest Yu</strong>
            <span>
              {recordCount} records · {photos.length} photographs
            </span>
          </p>
          {Object.entries(linkGroups).map(([group, links]) => (
            <section aria-labelledby={'links-' + group.toLowerCase()}>
              <h2 id={'links-' + group.toLowerCase()}>{group}</h2>
              <ul>
                {Object.entries(links).map(([name, href]) => (
                  <li>
                    <a href={href}>{name}</a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </footer>
    </div>
    <slot name="overlay" />
  </body>
</html>
